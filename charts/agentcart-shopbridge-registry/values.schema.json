{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "registry", "ingress", "networkPolicy"],
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 10},
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "registry": {
      "type": "object",
      "required": ["host", "tlsSecretName", "name", "stage", "updatedAt", "submissionMode", "entries", "onchain", "onchainEvents", "onchainRecords"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "tlsSecretName": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "enum": ["pilot", "production"]},
        "updatedAt": {"type": "string", "format": "date-time"},
        "submissionMode": {"type": "string", "enum": ["maintainer_curated"]},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["merchant_id", "name", "domain", "manifest_url", "proof_url", "revocation_url", "updated_at"],
            "properties": {
              "merchant_id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "domain": {"type": "string", "minLength": 1},
              "manifest_url": {"type": "string", "pattern": "^https://"},
              "proof_url": {"type": "string", "pattern": "^https://"},
              "revocation_url": {"type": "string", "pattern": "^https://"},
              "updated_at": {"type": "string", "format": "date-time"}
            }
          }
        },
        "onchain": {
          "type": "object",
          "required": ["ethereumMainnet", "tempo"],
          "properties": {
            "ethereumMainnet": {"$ref": "#/definitions/onchainDeployment"},
            "tempo": {"$ref": "#/definitions/onchainDeployment"}
          }
        },
        "onchainEvents": {
          "type": "object",
          "required": ["enabled", "source", "document", "rpcIndexer"],
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "source": {"type": "string", "enum": ["static", "rpc_indexer"]},
            "document": {"type": "object"},
            "rpcIndexer": {
              "type": "object",
              "required": ["deployment", "rpcUrl", "fromBlock", "chunkSize", "refreshSeconds", "image", "resources"],
              "additionalProperties": false,
              "properties": {
                "deployment": {"type": "string", "enum": ["ethereumMainnet", "tempo"]},
                "rpcUrl": {
                  "type": "string",
                  "pattern": "^(|https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?:/[^\\s]*)?)$"
                },
                "fromBlock": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
                "chunkSize": {"type": "integer", "minimum": 1, "maximum": 100000},
                "refreshSeconds": {"type": "integer", "minimum": 60, "maximum": 300},
                "image": {
                  "type": "object",
                  "required": ["repository", "digest", "pullPolicy"],
                  "additionalProperties": false,
                  "properties": {
                    "repository": {"type": "string", "minLength": 1},
                    "digest": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
                    "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
                  }
                },
                "resources": {"type": "object"}
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {"const": true},
                  "source": {"const": "static"}
                }
              },
              "then": {
                "properties": {
                  "document": {
                    "required": ["schema", "implementation", "chain_id", "registry_address", "finality", "indexed_at", "complete", "errors", "events"],
                    "properties": {
                      "schema": {"const": "agentcart.onchain_registry_contract_events.v1"},
                      "implementation": {"const": "agentcart.onchain_registry_rpc_indexer.v1"},
                      "chain_id": {"pattern": "^eip155:[0-9]+$"},
                      "registry_address": {"pattern": "^0x[0-9a-fA-F]{40}$"},
                      "complete": {"const": true},
                      "errors": {"type": "array", "maxItems": 0},
                      "events": {"type": "array"}
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "enabled": {"const": true},
                  "source": {"const": "rpc_indexer"}
                }
              },
              "then": {
                "properties": {
                  "rpcIndexer": {
                    "properties": {
                      "rpcUrl": {
                        "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?:/[^\\s]*)?$"
                      },
                      "image": {
                        "properties": {
                          "digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "onchainRecords": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recordHash", "document"],
            "additionalProperties": false,
            "properties": {
              "recordHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "document": {"type": "object", "minProperties": 1}
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string", "enum": ["haproxy"]}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressSourceCidrs", "dnsNamespaceSelector", "dnsPodSelector", "externalHttpsExceptCidrs", "externalHttpsExceptCidrsV6"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressSourceCidrs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "dnsNamespaceSelector": {"type": "object", "minProperties": 1},
        "dnsPodSelector": {"type": "object", "minProperties": 1},
        "externalHttpsExceptCidrs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "externalHttpsExceptCidrsV6": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      }
    }
  },
  "definitions": {
    "onchainDeployment": {
      "type": "object",
      "required": ["status", "chainId", "contractAddress", "explorerUrl"],
      "properties": {
        "status": {"type": "string", "enum": ["not_deployed", "testnet_only", "live"]},
        "chainId": {"type": "string"},
        "contractAddress": {"type": "string", "pattern": "^(|0x[0-9a-fA-F]{40})$"},
        "explorerUrl": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not_deployed"}}},
          "then": {
            "properties": {
              "contractAddress": {"const": ""},
              "explorerUrl": {"const": ""}
            }
          },
          "else": {
            "properties": {
              "chainId": {"pattern": "^[1-9][0-9]*$"},
              "contractAddress": {"pattern": "^0x[0-9a-fA-F]{40}$"},
              "explorerUrl": {"pattern": "^https://"}
            }
          }
        }
      ]
    }
  }
}
