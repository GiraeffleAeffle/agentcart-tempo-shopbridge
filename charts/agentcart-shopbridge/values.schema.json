{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret", "store", "ingress", "networkPolicy"],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1,
      "description": "Name of a separately provisioned Kubernetes Secret."
    },
    "store": {
      "type": "object",
      "required": ["host", "title", "merchantId", "environmentType", "marketProfile", "varianceProfile"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "merchantId": {"type": "string", "minLength": 1},
        "environmentType": {"type": "string", "enum": ["local", "development", "staging", "production"]},
        "marketProfile": {"type": "string", "minLength": 1},
        "varianceProfile": {"type": "string", "minLength": 1},
        "checkoutMode": {"type": "string", "enum": ["trusted_token_or_verifier", "external_verifier_only"]},
        "signedRequestMode": {"type": "string", "enum": ["off", "allow", "require_checkout", "require_mutations", "require_all_sensitive"]},
        "tempoRecipientAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "registryOnchain": {
          "type": "object",
          "required": ["controller", "chainId", "registryAddress", "recordId"],
          "properties": {
            "controller": {"type": "string", "pattern": "^(|0x[0-9a-fA-F]{40})$"},
            "chainId": {"type": "string", "pattern": "^(|eip155:[0-9]{1,20})$"},
            "registryAddress": {"type": "string", "pattern": "^(|0x[0-9a-fA-F]{40})$"},
            "recordId": {"type": "string", "pattern": "^(|0x[0-9a-fA-F]{64})$"}
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {"properties": {"controller": {"minLength": 1}}},
                  {"properties": {"chainId": {"minLength": 1}}},
                  {"properties": {"registryAddress": {"minLength": 1}}},
                  {"properties": {"recordId": {"minLength": 1}}}
                ]
              },
              "then": {
                "properties": {
                  "controller": {"minLength": 1},
                  "chainId": {"minLength": 1},
                  "registryAddress": {"minLength": 1},
                  "recordId": {"minLength": 1}
                }
              }
            }
          ]
        },
        "returnsPath": {"type": "string", "pattern": "^/"}
      }
    },
    "verifier": {
      "type": "object",
      "required": ["enabled", "enabledRails", "alerts", "replay", "persistence", "tempo"],
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "enabledRails": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["tempo-mpp", "stripe-card-mpp"]}
        },
        "alerts": {
          "type": "object",
          "required": ["enabled", "minSeverity", "throttleSeconds"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minSeverity": {"type": "string", "enum": ["info", "warning", "critical"]},
            "throttleSeconds": {"type": "integer", "minimum": 0, "maximum": 86400}
          }
        },
        "replay": {
          "type": "object",
          "required": ["driver", "requireDurable", "requireJournal"],
          "properties": {
            "driver": {"type": "string", "enum": ["sqlite"]},
            "requireDurable": {"const": true},
            "requireJournal": {"const": true}
          }
        },
        "persistence": {
          "type": "object",
          "required": ["size"],
          "properties": {
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}
          }
        },
        "tempo": {
          "type": "object",
          "required": ["settlementMode", "refundMode", "settlementTokenAddress", "refundTokenAddress"],
          "properties": {
            "settlementMode": {"type": "string", "enum": ["disabled", "verify"]},
            "refundMode": {"type": "string", "enum": ["disabled", "live"]},
            "settlementTokenAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
            "refundTokenAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {
          "type": "string",
          "enum": ["haproxy"],
          "description": "The chart's public admin-route controls are currently verified only with HAProxy Ingress."
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressSourceCidrs": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verifier": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "store": {
            "properties": {
              "checkoutMode": {"const": "external_verifier_only"},
              "signedRequestMode": {"enum": ["require_checkout", "require_mutations", "require_all_sensitive"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verifier": {
            "properties": {
              "enabled": {"const": true},
              "enabledRails": {"contains": {"const": "tempo-mpp"}}
            }
          }
        }
      },
      "then": {
        "properties": {
          "verifier": {
            "properties": {
              "tempo": {
                "properties": {
                  "settlementMode": {"const": "verify"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
