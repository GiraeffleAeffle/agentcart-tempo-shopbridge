{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["existingSecret", "store", "ingress", "networkPolicy"],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1,
      "description": "Name of a separately provisioned Kubernetes Secret."
    },
    "store": {
      "type": "object",
      "required": ["host", "title", "merchantId", "environmentType", "marketProfile", "varianceProfile"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "merchantId": {"type": "string", "minLength": 1},
        "environmentType": {"type": "string", "enum": ["local", "development", "staging", "production"]},
        "marketProfile": {"type": "string", "minLength": 1},
        "varianceProfile": {"type": "string", "minLength": 1},
        "checkoutMode": {"type": "string", "enum": ["trusted_token_or_verifier", "external_verifier_only"]},
        "signedRequestMode": {"type": "string", "enum": ["off", "allow", "require_checkout", "require_mutations", "require_all_sensitive"]},
        "tempoRecipientAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
        "registryOnchain": {
          "type": "object",
          "required": ["controller", "chainId", "registryAddress", "recordId"],
          "properties": {
            "controller": {"type": "string", "pattern": "^(|0x[0-9a-fA-F]{40})$"},
            "chainId": {"type": "string", "pattern": "^(|eip155:[0-9]{1,20})$"},
            "registryAddress": {"type": "string", "pattern": "^(|0x[0-9a-fA-F]{40})$"},
            "recordId": {"type": "string", "pattern": "^(|0x[0-9a-fA-F]{64})$"}
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {"properties": {"controller": {"minLength": 1}}},
                  {"properties": {"chainId": {"minLength": 1}}},
                  {"properties": {"registryAddress": {"minLength": 1}}},
                  {"properties": {"recordId": {"minLength": 1}}}
                ]
              },
              "then": {
                "properties": {
                  "controller": {"minLength": 1},
                  "chainId": {"minLength": 1},
                  "registryAddress": {"minLength": 1},
                  "recordId": {"minLength": 1}
                }
              }
            }
          ]
        },
        "x402": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network", "asset", "payTo", "maxTimeoutSeconds"],
          "properties": {
            "network": {"type": "string", "enum": ["", "eip155:84532"]},
            "asset": {"type": "string", "enum": ["", "0x036CbD53842c5426634e7929541eC2318f3dCF7e"]},
            "payTo": {"type": "string", "pattern": "^(|0x[0-9a-fA-F]{40})$"},
            "maxTimeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 300}
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {"properties": {"network": {"minLength": 1}}},
                  {"properties": {"asset": {"minLength": 1}}},
                  {"properties": {"payTo": {"minLength": 1}}}
                ]
              },
              "then": {
                "properties": {
                  "network": {"minLength": 1},
                  "asset": {"minLength": 1},
                  "payTo": {"minLength": 1}
                }
              }
            }
          ]
        },
        "returnsPath": {"type": "string", "pattern": "^/"}
      }
    },
    "scheduler": {"type": "object", "required": ["enabled", "resources"], "properties": {"enabled": {"type": "boolean"}, "resources": {"type": "object"}}},
    "verifier": {
      "type": "object",
      "required": ["enabled", "enabledRails", "alerts", "replay", "persistence", "tempo", "x402"],
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "reconciliationEnabled": {"type": "boolean"},
        "allowedTempoNetworks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["testnet", "mainnet"]}},
        "enabledRails": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["tempo-mpp", "stripe-card-mpp", "x402-compatible"]}
        },
        "alerts": {
          "type": "object",
          "required": ["enabled", "minSeverity", "throttleSeconds"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minSeverity": {"type": "string", "enum": ["info", "warning", "critical"]},
            "throttleSeconds": {"type": "integer", "minimum": 0, "maximum": 86400}
          }
        },
        "replay": {
          "type": "object",
          "required": ["driver", "requireDurable", "requireJournal"],
          "properties": {
            "driver": {"type": "string", "enum": ["sqlite"]},
            "requireDurable": {"const": true},
            "requireJournal": {"const": true}
          }
        },
        "persistence": {
          "type": "object",
          "required": ["size"],
          "properties": {
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}
          }
        },
        "x402": {
          "type": "object",
          "required": ["mode", "network", "facilitatorUrl", "rpcUrl", "confirmations", "facilitatorTimeoutMs"],
          "properties": {
            "mode": {"type": "string", "enum": ["disabled", "settle"], "default": "disabled"},
            "network": {"const": "eip155:84532"},
            "facilitatorUrl": {"type": "string", "pattern": "^https://[^/?#]+(?:/[^?#]*)?$", "default": "https://x402.org/facilitator"},
            "rpcUrl": {"type": "string", "pattern": "^https://[^/?#]+(?:/[^?#]*)?$", "default": "https://sepolia.base.org"},
            "confirmations": {"type": "integer", "minimum": 1, "default": 1},
            "facilitatorTimeoutMs": {"type": "integer", "minimum": 100, "maximum": 7000, "default": 7000}
          }
        },
        "tempo": {
          "type": "object",
          "required": ["settlementMode", "refundMode", "settlementTokenAddress", "refundTokenAddress"],
          "properties": {
            "settlementMode": {"type": "string", "enum": ["disabled", "verify"]},
            "refundMode": {"type": "string", "enum": ["disabled", "live"]},
            "settlementTokenAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
            "refundTokenAddress": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {
          "type": "string",
          "enum": ["haproxy"],
          "description": "The chart's public admin-route controls are currently verified only with HAProxy Ingress."
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressSourceCidrs": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verifier": {"properties": {"enabled": {"const": true}}}}},
      "then": {
        "properties": {
          "store": {
            "properties": {
              "checkoutMode": {"const": "external_verifier_only"},
              "signedRequestMode": {"enum": ["require_checkout", "require_mutations", "require_all_sensitive"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verifier": {
            "properties": {
              "enabled": {"const": true},
              "enabledRails": {"contains": {"const": "tempo-mpp"}}
            }
          }
        }
      },
      "then": {
        "properties": {
          "verifier": {
            "properties": {
              "tempo": {
                "properties": {
                  "settlementMode": {"const": "verify"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["verifier"],
        "properties": {
          "verifier": {
            "required": ["enabled", "enabledRails"],
            "properties": {
              "enabled": {"const": true},
              "enabledRails": {"contains": {"const": "x402-compatible"}}
            }
          }
        }
      },
      "then": {
        "properties": {
          "verifier": {
            "properties": {
              "x402": {"properties": {"mode": {"const": "settle"}}},
              "replay": {"properties": {"driver": {"const": "sqlite"}, "requireDurable": {"const": true}}}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["verifier"],
        "properties": {
          "verifier": {
            "required": ["enabled", "enabledRails"],
            "properties": {
              "enabled": {"const": true},
              "enabledRails": {
                "allOf": [
                  {"contains": {"const": "tempo-mpp"}},
                  {"not": {"contains": {"const": "stripe-card-mpp"}}}
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "store": {
            "properties": {
              "marketProfile": {"not": {"const": "eur"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["store"],
        "properties": {
          "store": {
            "required": ["x402"],
            "properties": {"x402": {"required": ["network"], "properties": {"network": {"minLength": 1}}}}
          }
        }
      },
      "then": {
        "required": ["verifier"],
        "properties": {
          "store": {"properties": {"marketProfile": {"const": "usd"}}},
          "verifier": {
            "required": ["enabled", "enabledRails", "x402"],
            "properties": {
              "enabled": {"const": true},
              "enabledRails": {"contains": {"const": "x402-compatible"}},
              "x402": {"required": ["mode"], "properties": {"mode": {"const": "settle"}}}
            }
          }
        }
      }
    }
  ]
}
